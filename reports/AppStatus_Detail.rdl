          <Textbox Name="txtInventoryHinweis">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=IIF(IsNothing(First(Fields!LetzteInventory.Value, "AppStatus")),
  "Kein Hardware Inventory vorhanden - Installationsdaten nicht verfuegbar",
  IIF(First(Fields!InventoryAlterTage.Value, "AppStatus") &gt; 7,
      "Hardware Inventory veraltet (" &amp; First(Fields!InventoryAlterTage.Value, "AppStatus") &amp; " Tage) - Daten moeglicherweise unvollstaendig",
  IIF(First(Fields!InventoryAlterTage.Value, "AppStatus") &gt; 2,
      "Hardware Inventory " &amp; First(Fields!InventoryAlterTage.Value, "AppStatus") &amp; " Tage alt",
      "Hardware Inventory aktuell  (Stand: " &amp; Format(First(Fields!LetzteInventory.Value, "AppStatus"), "dd.MM.yyyy HH:mm") &amp; ")")))</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <Color>=IIF(IsNothing(First(Fields!LetzteInventory.Value, "AppStatus")), "#721C24",
  IIF(First(Fields!InventoryAlterTage.Value, "AppStatus") &gt; 7, "#721C24",
  IIF(First(Fields!InventoryAlterTage.Value, "AppStatus") &gt; 2, "#856404", "#155724")))</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>1.9cm</Top>
            <Height>0.7cm</Height>
            <Width>19.92604cm</Width>
            <ZIndex>1</ZIndex>
            <Style>
              <Border>
                <Color>=IIF(IsNothing(First(Fields!LetzteInventory.Value, "AppStatus")), "#F5C6CB",
  IIF(First(Fields!InventoryAlterTage.Value, "AppStatus") &gt; 7, "#F5C6CB",
  IIF(First(Fields!InventoryAlterTage.Value, "AppStatus") &gt; 2, "#FFEEBA", "#C3E6CB")))</Color>
                <Style>Solid</Style>
                <Width>0.5pt</Width>
              </Border>
              <BackgroundColor>=IIF(IsNothing(First(Fields!LetzteInventory.Value, "AppStatus")), "#F8D7DA",
  IIF(First(Fields!InventoryAlterTage.Value, "AppStatus") &gt; 7, "#F8D7DA",
