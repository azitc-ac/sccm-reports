    <DataSet Name="AppStatus">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@UserSIDs">
            <Value>=Parameters!UserSIDs.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ComputerName">
            <Value>=Parameters!ComputerName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    ads.MachineName,
    CASE WHEN CHARINDEX(' - ', app.DisplayName) &gt; 0
                THEN LEFT(app.DisplayName, CHARINDEX(' - ', app.DisplayName) - 1)
                ELSE app.DisplayName END                                                AS AppName,
    app.Manufacturer                                          AS Publisher,
    app.SoftwareVersion,
    CASE
        WHEN arp.DisplayName0 IS NOT NULL AND NULLIF(arp.Version0, '') IS NOT NULL AND c.Cmp = 0  THEN 'Installiert'
        WHEN arp.DisplayName0 IS NOT NULL AND NULLIF(arp.Version0, '') IS NOT NULL AND c.Cmp &gt; 0  THEN 'Installiert (neuer)'
        WHEN arp.DisplayName0 IS NOT NULL AND NULLIF(arp.Version0, '') IS NOT NULL                 THEN 'Installiert (veraltet)'
        WHEN arp.DisplayName0 IS NOT NULL AND ads.InstalledState = 2 AND ads.ComplianceState = 1   THEN 'Installiert (Version unbekannt)'
        WHEN arp.DisplayName0 IS NOT NULL                                                          THEN 'ARP-Eintrag ohne Version'
        -- No ARP entry: EnforcementState 1001 alone is not proof of an installation
        WHEN ads.InstalledState = 2 AND ads.ComplianceState = 1                                    THEN 'Installiert (kein ARP-Eintrag)'
        WHEN ads.EnforcementState IS NULL                                                          THEN 'Ausstehend'
        WHEN ads.EnforcementState BETWEEN 1000 AND 1999                                            THEN 'Erfolg gemeldet, nicht nachgewiesen (' + CAST(ads.EnforcementState AS nvarchar(10)) + ')'
        WHEN ads.EnforcementState BETWEEN 2000 AND 2999                                            THEN 'In Bearbeitung (' + CAST(ads.EnforcementState AS nvarchar(10)) + ')'
        WHEN ads.EnforcementState BETWEEN 3000 AND 3999                                            THEN 'Anforderungen nicht erfüllt'
        WHEN ads.EnforcementState BETWEEN 4000 AND 4999                                            THEN 'Unbekannt (' + CAST(ads.EnforcementState AS nvarchar(10)) + ')'
        WHEN ads.EnforcementState BETWEEN 5000 AND 5999                                            THEN 'Fehlgeschlagen (' + CAST(ads.EnforcementState AS nvarchar(10)) + ')'
        ELSE 'Unbekannt (' + CAST(ads.EnforcementState AS nvarchar(10)) + ')'
    END                                             AS StatusText,
    CASE
        WHEN arp.InstallDate0 IS NOT NULL AND LEN(arp.InstallDate0) = 8 AND TRY_CONVERT(date, arp.InstallDate0, 112) IS NOT NULL
        THEN CONVERT(date, arp.InstallDate0, 112)
        ELSE NULL
    END                                            AS InstallDatum,
    CASE
        WHEN arp.DisplayName0 IS NULL     THEN 'Kein ARP-Eintrag'
        WHEN arp.InstallDate0 IS NULL     THEN 'Datum nicht hinterlegt'
        ELSE NULL
    END                                                       AS InstallDatumHinweis,
    arp.Version0                                              AS ARP_Version,
    ws.LastHWScan                                             AS LetzteInventory,
    DATEDIFF(day, ws.LastHWScan, GETDATE())                   AS InventoryAlterTage
FROM fn_rbac_AppDeploymentAssetDetails(1033, @UserSIDs) ads
INNER JOIN v_ApplicationAssignment aa
    ON  aa.AssignmentID   = ads.AssignmentID
    AND aa.OfferTypeID    = 0
    AND aa.CollectionName LIKE 'ins-req-dev-%'
INNER JOIN v_Applications app ON app.ModelId = aa.AppModelID
OUTER APPLY (
    -- The ARP entry of the deployed product: the shortest display name that
    -- starts with the application name, highest version first.
    SELECT TOP 1 DisplayName0, InstallDate0, Version0
    FROM (
        SELECT DisplayName0, InstallDate0, Version0, ResourceID FROM v_GS_ADD_REMOVE_PROGRAMS
        UNION ALL
        SELECT DisplayName0, InstallDate0, Version0, ResourceID FROM v_GS_ADD_REMOVE_PROGRAMS_64
    ) arp_all
    WHERE arp_all.ResourceID = ads.MachineID
      AND arp_all.DisplayName0 LIKE CASE WHEN CHARINDEX(' - ', app.DisplayName) &gt; 0
                THEN LEFT(app.DisplayName, CHARINDEX(' - ', app.DisplayName) - 1)
                ELSE app.DisplayName END + '%'
    ORDER BY LEN(arp_all.DisplayName0) ASC, arp_all.Version0 DESC
) arp
CROSS APPLY (
    -- Both versions cut or padded to four numeric segments, left aligned.
    -- PARSENAME counts from the right, so without this '26.02' against
    -- '25.01.00.0' compares 26 with 25's revision and the older build wins.
    SELECT
        Ist  = CASE WHEN LEN(x.i) - LEN(REPLACE(x.i, '.', '')) &gt;= 4
             THEN LEFT(x.i, CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.') + 1) + 1) + 1) - 1)
             ELSE x.i + REPLICATE('.0', 3 - (LEN(x.i) - LEN(REPLACE(x.i, '.', ''))))
        END,
        Soll = CASE WHEN LEN(x.s) - LEN(REPLACE(x.s, '.', '')) &gt;= 4
             THEN LEFT(x.s, CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.') + 1) + 1) + 1) - 1)
             ELSE x.s + REPLICATE('.0', 3 - (LEN(x.s) - LEN(REPLACE(x.s, '.', ''))))
        END
    FROM (SELECT i = LTRIM(RTRIM(ISNULL(arp.Version0, ''))), s = LTRIM(RTRIM(ISNULL(app.SoftwareVersion, '')))) x
) v
CROSS APPLY (
    -- 1 = installed is newer, 0 = same, -1 = installed is older
    SELECT Cmp = CASE
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 4) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 4) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 4) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 4) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 3) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 3) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 3) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 3) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 2) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 2) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 2) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 2) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 1) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 1) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 1) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 1) AS INT), 0) THEN -1
        ELSE 0 END
) c
LEFT JOIN v_GS_WORKSTATION_STATUS ws ON ws.ResourceID = ads.MachineID
WHERE ads.MachineName = @ComputerName
ORDER BY AppName</CommandText>
      </Query>
      <Fields>
        <Field Name="MachineName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>MachineName</DataField>
        </Field>
        <Field Name="AppName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>AppName</DataField>
        </Field>
        <Field Name="Publisher">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Publisher</DataField>
        </Field>
        <Field Name="SoftwareVersion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SoftwareVersion</DataField>
        </Field>
        <Field Name="StatusText">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>StatusText</DataField>
        </Field>
        <Field Name="InstallDatum">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>InstallDatum</DataField>
        </Field>
        <Field Name="InstallDatumHinweis">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>InstallDatumHinweis</DataField>
        </Field>
        <Field Name="ARP_Version">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ARP_Version</DataField>
        </Field>
        <Field Name="LetzteInventory">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>LetzteInventory</DataField>
        </Field>
        <Field Name="InventoryAlterTage">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>InventoryAlterTage</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Summary">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@UserSIDs">
            <Value>=Parameters!UserSIDs.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ComputerName">
            <Value>=Parameters!ComputerName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    COUNT(s.IsInstalled)          AS Apps_Gesamt,
    ISNULL(SUM(s.IsInstalled), 0) AS Apps_Installiert
FROM (
    SELECT CASE
        -- ARP entry with a version: the comparison decides, nothing else
        WHEN arp.DisplayName0 IS NOT NULL AND NULLIF(arp.Version0, '') IS NOT NULL AND c.Cmp &gt;= 0 THEN 1
        WHEN arp.DisplayName0 IS NOT NULL AND NULLIF(arp.Version0, '') IS NOT NULL                THEN 0
        -- ARP entry without a version, or no ARP entry at all: only the
        -- client's own installed + compliant counts (products that do not
        -- register in ARP, e.g. Oracle). EnforcementState 1001 alone is not
        -- proof of an installation.
        WHEN ads.InstalledState = 2 AND ads.ComplianceState = 1                                  THEN 1
        -- Requirements not met: not applicable, neither installed nor missing
        WHEN ads.EnforcementState &gt;= 3000 AND ads.EnforcementState &lt; 4000                        THEN NULL
        ELSE 0
    END AS IsInstalled
    FROM fn_rbac_AppDeploymentAssetDetails(1033, @UserSIDs) ads
INNER JOIN v_ApplicationAssignment aa
    ON  aa.AssignmentID   = ads.AssignmentID
    AND aa.OfferTypeID    = 0
    AND aa.CollectionName LIKE 'ins-req-dev-%'
INNER JOIN v_Applications app ON app.ModelId = aa.AppModelID
    OUTER APPLY (
    -- The ARP entry of the deployed product: the shortest display name that
    -- starts with the application name, highest version first.
    SELECT TOP 1 DisplayName0, Version0
    FROM (
        SELECT DisplayName0, InstallDate0, Version0, ResourceID FROM v_GS_ADD_REMOVE_PROGRAMS
        UNION ALL
        SELECT DisplayName0, InstallDate0, Version0, ResourceID FROM v_GS_ADD_REMOVE_PROGRAMS_64
    ) arp_all
    WHERE arp_all.ResourceID = ads.MachineID
      AND arp_all.DisplayName0 LIKE CASE WHEN CHARINDEX(' - ', app.DisplayName) &gt; 0
                THEN LEFT(app.DisplayName, CHARINDEX(' - ', app.DisplayName) - 1)
                ELSE app.DisplayName END + '%'
    ORDER BY LEN(arp_all.DisplayName0) ASC, arp_all.Version0 DESC
) arp
    CROSS APPLY (
    -- Both versions cut or padded to four numeric segments, left aligned.
    -- PARSENAME counts from the right, so without this '26.02' against
    -- '25.01.00.0' compares 26 with 25's revision and the older build wins.
    SELECT
        Ist  = CASE WHEN LEN(x.i) - LEN(REPLACE(x.i, '.', '')) &gt;= 4
             THEN LEFT(x.i, CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.') + 1) + 1) + 1) - 1)
             ELSE x.i + REPLICATE('.0', 3 - (LEN(x.i) - LEN(REPLACE(x.i, '.', ''))))
        END,
        Soll = CASE WHEN LEN(x.s) - LEN(REPLACE(x.s, '.', '')) &gt;= 4
             THEN LEFT(x.s, CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.') + 1) + 1) + 1) - 1)
             ELSE x.s + REPLICATE('.0', 3 - (LEN(x.s) - LEN(REPLACE(x.s, '.', ''))))
        END
    FROM (SELECT i = LTRIM(RTRIM(ISNULL(arp.Version0, ''))), s = LTRIM(RTRIM(ISNULL(app.SoftwareVersion, '')))) x
) v
CROSS APPLY (
    -- 1 = installed is newer, 0 = same, -1 = installed is older
    SELECT Cmp = CASE
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 4) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 4) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 4) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 4) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 3) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 3) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 3) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 3) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 2) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 2) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 2) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 2) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 1) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 1) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 1) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 1) AS INT), 0) THEN -1
        ELSE 0 END
) c
    WHERE ads.MachineName = @ComputerName
) s</CommandText>
      </Query>
      <Fields>
        <Field Name="Apps_Gesamt">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Apps_Gesamt</DataField>
        </Field>
        <Field Name="Apps_Installiert">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Apps_Installiert</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
