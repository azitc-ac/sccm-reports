  <DataSets>
    <DataSet Name="DataSetAdminID">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@UserTokenSIDs">
            <Value>=Parameters!UserTokenSIDs.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select dbo.fn_rbac_GetAdminIDsfromUserSIDs(@UserTokenSIDs) as UserSIDs</CommandText>
      </Query>
      <Fields>
        <Field Name="UserSIDs"><rd:TypeName>System.String</rd:TypeName><DataField>UserSIDs</DataField></Field>
      </Fields>
    </DataSet>

    <DataSet Name="AllApps">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ComputerName">
            <Value>=Parameters!ComputerName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
SELECT
    arp.DisplayName0                                          AS AppName,
    arp.Publisher0                                            AS Publisher,
    arp.Version0                                              AS Version,
    CASE
        WHEN arp.InstallDate0 IS NOT NULL AND LEN(arp.InstallDate0) = 8
        THEN CONVERT(date, arp.InstallDate0, 112)
        ELSE NULL
    END                                                       AS InstallDatum,
    '32-bit'                                                  AS Architektur
FROM v_GS_ADD_REMOVE_PROGRAMS arp
INNER JOIN v_R_System sys ON sys.ResourceID = arp.ResourceID
WHERE sys.Name0 = @ComputerName
  AND NULLIF(LTRIM(RTRIM(arp.DisplayName0)), '') IS NOT NULL

UNION ALL

SELECT
    arp64.DisplayName0                                        AS AppName,
    arp64.Publisher0                                          AS Publisher,
    arp64.Version0                                            AS Version,
    CASE
        WHEN arp64.InstallDate0 IS NOT NULL AND LEN(arp64.InstallDate0) = 8
        THEN CONVERT(date, arp64.InstallDate0, 112)
        ELSE NULL
    END                                                       AS InstallDatum,
    '64-bit'                                                  AS Architektur
FROM v_GS_ADD_REMOVE_PROGRAMS_64 arp64
INNER JOIN v_R_System sys ON sys.ResourceID = arp64.ResourceID
WHERE sys.Name0 = @ComputerName
  AND NULLIF(LTRIM(RTRIM(arp64.DisplayName0)), '') IS NOT NULL

ORDER BY AppName, Architektur
        </CommandText>
      </Query>
      <Fields>
        <Field Name="AppName"><DataField>AppName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Publisher"><DataField>Publisher</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Version"><DataField>Version</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="InstallDatum"><DataField>InstallDatum</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Architektur"><DataField>Architektur</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <DataSet Name="Summary">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ComputerName">
            <Value>=Parameters!ComputerName.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
SELECT COUNT(*) AS Apps_Gesamt
FROM (
    SELECT DisplayName0 FROM v_GS_ADD_REMOVE_PROGRAMS arp
    INNER JOIN v_R_System sys ON sys.ResourceID = arp.ResourceID
    WHERE sys.Name0 = @ComputerName
      AND NULLIF(LTRIM(RTRIM(arp.DisplayName0)), '') IS NOT NULL
    UNION ALL
    SELECT DisplayName0 FROM v_GS_ADD_REMOVE_PROGRAMS_64 arp64
    INNER JOIN v_R_System sys ON sys.ResourceID = arp64.ResourceID
    WHERE sys.Name0 = @ComputerName
      AND NULLIF(LTRIM(RTRIM(arp64.DisplayName0)), '') IS NOT NULL
) t
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Apps_Gesamt"><DataField>Apps_Gesamt</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

