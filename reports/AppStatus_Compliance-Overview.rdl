                        <Value>=Fields!CompliantClients.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#155724</Color></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <BackgroundColor>#D4EDDA</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border>
                        <BottomBorder><Style>Solid</Style><Color>#ddeaf5</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="ddNonCompliant">
                      <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!NonCompliantClients.Value = 0, "–", CStr(Fields!NonCompliantClients.Value))</Value>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight>
                          <Color>=IIF(Fields!NonCompliantClients.Value = 0, "#AAAAAA", "#721C24")</Color>
                        </Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <BackgroundColor>=IIF(Fields!NonCompliantClients.Value = 0, "#D4EDDA", "#F8D7DA")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border>
                        <BottomBorder><Style>Solid</Style><Color>#ddeaf5</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="ddComplianceBar">
                      <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=New String(CChar(ChrW(9608)), CInt(Math.Round(Fields!CompliantClients.Value / CDbl(Fields!TotalClients.Value) * 10))) &amp; New String(CChar(ChrW(9617)), 10 - CInt(Math.Round(Fields!CompliantClients.Value / CDbl(Fields!TotalClients.Value) * 10))) &amp; "  " &amp; Format(Fields!CompliantClients.Value / CDbl(Fields!TotalClients.Value), "0%")</Value>
                        <Style>
                          <FontFamily>Courier New</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight>
                          <Color>=IIF(Fields!CompliantClients.Value = Fields!TotalClients.Value, "#155724", IIF(Fields!CompliantClients.Value / CDbl(Fields!TotalClients.Value) &gt;= 0.5, "#856404", "#721C24"))</Color>
                        </Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <BackgroundColor>=IIF(Fields!CompliantClients.Value = Fields!TotalClients.Value, "#D4EDDA", IIF(Fields!CompliantClients.Value / CDbl(Fields!TotalClients.Value) &gt;= 0.5, "#FFF3CD", "#F8D7DA"))</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border>
                        <BottomBorder><Style>Solid</Style><Color>#ddeaf5</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingLeft>6pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                      </Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
