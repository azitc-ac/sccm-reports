                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><BackgroundColor>#005a9e</BackgroundColor><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border><BottomBorder><Style>Solid</Style><Color>#003f73</Color><Width>1pt</Width></BottomBorder><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>9mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="ddServerRolle">
                      <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ServerRolle.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>Underline</TextDecoration><Color>#0078d4</Color></Style>
                      </TextRun></TextRuns><Style/></Paragraph></Paragraphs>
                      <ActionInfo><Actions><Action>
                        <Drillthrough>
                          <ReportName>/ConfigMgr_P01/Softwareverteilung - Anwendungsüberwachung/Anwendungs-Installationsstatus - Übersicht</ReportName>
                          <Parameters>
                            <Parameter Name="RolleFilter">
                              <Value>=Fields!ServerRolle.Value</Value>
                            </Parameter>
                          </Parameters>
                        </Drillthrough>
                      </Action></Actions></ActionInfo>
