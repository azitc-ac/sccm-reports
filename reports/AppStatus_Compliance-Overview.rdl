                      <Style>
                        <BackgroundColor>=IIF(RowNumber("grpDashRole") MOD 2 = 0, "#EEF4FB", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border>
                        <BottomBorder><Style>Solid</Style><Color>#ddeaf5</Color><Width>0.5pt</Width></BottomBorder>
