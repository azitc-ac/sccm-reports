<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
  <rd:ReportServerUrl>http://CMSERVER/ReportServer</rd:ReportServerUrl>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CMSERVER;Initial Catalog=CM_P01</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>11111111-1111-1111-1111-111111111111</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="DataSetAdminID">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@UserTokenSIDs">
            <Value>=Parameters!UserTokenSIDs.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select dbo.fn_rbac_GetAdminIDsfromUserSIDs(@UserTokenSIDs) as UserSIDs</CommandText>
      </Query>
      <Fields>
        <Field Name="UserSIDs"><rd:TypeName>System.String</rd:TypeName><DataField>UserSIDs</DataField></Field>
      </Fields>
    </DataSet>

    <DataSet Name="DashboardData">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@UserSIDs">
            <Value>=Parameters!UserSIDs.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH AppStatusPerDevice AS (
    SELECT
        ads.MachineID,
        CASE
        -- ARP entry with a version: the comparison decides, nothing else
        WHEN arp.DisplayName0 IS NOT NULL AND NULLIF(arp.Version0, '') IS NOT NULL AND c.Cmp &gt;= 0 THEN 1
        WHEN arp.DisplayName0 IS NOT NULL AND NULLIF(arp.Version0, '') IS NOT NULL                THEN 0
        -- ARP entry without a version, or no ARP entry at all: only the
        -- client's own installed + compliant counts (products that do not
        -- register in ARP, e.g. Oracle). EnforcementState 1001 alone is not
        -- proof of an installation.
        WHEN ads.InstalledState = 2 AND ads.ComplianceState = 1                                  THEN 1
        -- Requirements not met: not applicable, neither installed nor missing
        WHEN ads.EnforcementState &gt;= 3000 AND ads.EnforcementState &lt; 4000                        THEN NULL
        ELSE 0
    END AS IsInstalled
    FROM fn_rbac_AppDeploymentAssetDetails(1033, @UserSIDs) ads
INNER JOIN v_ApplicationAssignment aa
    ON  aa.AssignmentID   = ads.AssignmentID
    AND aa.OfferTypeID    = 0
    AND aa.CollectionName LIKE 'ins-req-dev-%'
INNER JOIN v_Applications app ON app.ModelId = aa.AppModelID
    OUTER APPLY (
    -- The ARP entry of the deployed product: the shortest display name that
    -- starts with the application name, highest version first.
    SELECT TOP 1 DisplayName0, Version0
    FROM (
        SELECT DisplayName0, InstallDate0, Version0, ResourceID FROM v_GS_ADD_REMOVE_PROGRAMS
        UNION ALL
        SELECT DisplayName0, InstallDate0, Version0, ResourceID FROM v_GS_ADD_REMOVE_PROGRAMS_64
    ) arp_all
    WHERE arp_all.ResourceID = ads.MachineID
      AND arp_all.DisplayName0 LIKE CASE WHEN CHARINDEX(' - ', app.DisplayName) &gt; 0
                THEN LEFT(app.DisplayName, CHARINDEX(' - ', app.DisplayName) - 1)
                ELSE app.DisplayName END + '%'
    ORDER BY LEN(arp_all.DisplayName0) ASC, arp_all.Version0 DESC
) arp
    CROSS APPLY (
    -- Both versions cut or padded to four numeric segments, left aligned.
    -- PARSENAME counts from the right, so without this '26.02' against
    -- '25.01.00.0' compares 26 with 25's revision and the older build wins.
    SELECT
        Ist  = CASE WHEN LEN(x.i) - LEN(REPLACE(x.i, '.', '')) &gt;= 4
             THEN LEFT(x.i, CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.', CHARINDEX('.', x.i + '.') + 1) + 1) + 1) - 1)
             ELSE x.i + REPLICATE('.0', 3 - (LEN(x.i) - LEN(REPLACE(x.i, '.', ''))))
        END,
        Soll = CASE WHEN LEN(x.s) - LEN(REPLACE(x.s, '.', '')) &gt;= 4
             THEN LEFT(x.s, CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.', CHARINDEX('.', x.s + '.') + 1) + 1) + 1) - 1)
             ELSE x.s + REPLICATE('.0', 3 - (LEN(x.s) - LEN(REPLACE(x.s, '.', ''))))
        END
    FROM (SELECT i = LTRIM(RTRIM(ISNULL(arp.Version0, ''))), s = LTRIM(RTRIM(ISNULL(app.SoftwareVersion, '')))) x
) v
CROSS APPLY (
    -- 1 = installed is newer, 0 = same, -1 = installed is older
    SELECT Cmp = CASE
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 4) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 4) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 4) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 4) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 3) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 3) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 3) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 3) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 2) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 2) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 2) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 2) AS INT), 0) THEN -1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 1) AS INT), 0) &gt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 1) AS INT), 0) THEN 1
        WHEN ISNULL(TRY_CAST(PARSENAME(v.Ist, 1) AS INT), 0) &lt; ISNULL(TRY_CAST(PARSENAME(v.Soll, 1) AS INT), 0) THEN -1
        ELSE 0 END
) c
),
DeviceSummary AS (
    SELECT
        REPLACE(role_col.Name, 'rol-dev-', '') AS ServerRolle,
        cte.MachineID,
        COUNT(cte.IsInstalled)                  AS Apps_Gesamt,
        ISNULL(SUM(cte.IsInstalled), 0)         AS Apps_Installiert
    FROM AppStatusPerDevice cte
    INNER JOIN v_FullCollectionMembership role_mem ON role_mem.ResourceID = cte.MachineID
    INNER JOIN v_Collection role_col
        ON  role_mem.CollectionID = role_col.CollectionID
        AND role_col.Name LIKE 'rol-dev-%'
    GROUP BY role_col.Name, cte.MachineID
    HAVING COUNT(cte.IsInstalled) &gt; 0
)
SELECT
    ServerRolle,
    COUNT(*)                                                          AS TotalClients,
    SUM(CASE WHEN Apps_Installiert = Apps_Gesamt THEN 1 ELSE 0 END)  AS CompliantClients,
    SUM(CASE WHEN Apps_Installiert &lt; Apps_Gesamt THEN 1 ELSE 0 END)  AS NonCompliantClients
FROM DeviceSummary
GROUP BY ServerRolle
ORDER BY ServerRolle</CommandText>
      </Query>
      <Fields>
        <Field Name="ServerRolle"><rd:TypeName>System.String</rd:TypeName><DataField>ServerRolle</DataField></Field>
        <Field Name="TotalClients"><rd:TypeName>System.Int32</rd:TypeName><DataField>TotalClients</DataField></Field>
        <Field Name="CompliantClients"><rd:TypeName>System.Int32</rd:TypeName><DataField>CompliantClients</DataField></Field>
        <Field Name="NonCompliantClients"><rd:TypeName>System.Int32</rd:TypeName><DataField>NonCompliantClients</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportParameters>
    <ReportParameter Name="UserTokenSIDs">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>=SrsResources.UserIdentity.GetUserSIDs(User!UserID)</Value></Values></DefaultValue>
      <Hidden>true</Hidden>
    </ReportParameter>    <ReportParameter Name="UserSIDs">
      <DataType>String</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DataSetAdminID</DataSetName>
          <ValueField>UserSIDs</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Hidden>true</Hidden>
    </ReportParameter>
  </ReportParameters>

