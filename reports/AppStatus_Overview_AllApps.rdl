<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"
        xmlns:am="http://schemas.microsoft.com/sqlserver/reporting/authoringmetadata">
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
  <rd:ReportServerUrl>http://CMSERVER/ReportServer</rd:ReportServerUrl>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CMSERVER;Initial Catalog=CM_P01</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>11111111-1111-1111-1111-111111111111</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <DataSets>

    <DataSet Name="DataSetAdminID">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@UserTokenSIDs">
            <Value>=Parameters!UserTokenSIDs.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select dbo.fn_rbac_GetAdminIDsfromUserSIDs(@UserTokenSIDs) as UserSIDs</CommandText>
      </Query>
      <Fields>
        <Field Name="UserSIDs"><rd:TypeName>System.String</rd:TypeName><DataField>UserSIDs</DataField></Field>
      </Fields>
    </DataSet>

    <!-- Nur rol-dev-* Collections im Dropdown -->
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <CommandText>
SELECT CollectionID, Name
FROM v_Collection
WHERE Name LIKE 'rol-dev-%'
ORDER BY Name
        </CommandText>
      </Query>
      <Fields>
        <Field Name="CollectionID"><DataField>CollectionID</DataField></Field>
        <Field Name="Name"><DataField>Name</DataField></Field>
      </Fields>
    </DataSet>

    <!-- Haupt-Dataset: eine Zeile pro Computer pro Software -->
    <DataSet Name="DataSet0">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CollID">
            <Value>=Parameters!CollID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
SELECT
    CASE
        WHEN NULLIF(LTRIM(RTRIM(dbo.fn_RemoveNonPrintableChars(arp.DisplayName0))), '') IS NOT NULL
        THEN dbo.fn_RemoveNonPrintableChars(arp.DisplayName0)
        WHEN NULLIF(LTRIM(RTRIM(arp.ProdID0)), '') IS NOT NULL
        THEN arp.ProdID0 + ' (kein Anzeigename)'
        ELSE '(kein Anzeigename)'
    END                                                       AS DisplayName0,
    Publisher0,
    Version0,
    sys.Name0                                                 AS ComputerName,
    @CollID                                                   AS CollectionID
FROM v_GS_ADD_REMOVE_PROGRAMS arp
JOIN v_FullCollectionMembership fcm ON arp.ResourceID = fcm.ResourceID
JOIN v_R_System sys ON sys.ResourceID = arp.ResourceID
WHERE fcm.CollectionID = @CollID
UNION ALL
SELECT
    CASE
        WHEN NULLIF(LTRIM(RTRIM(dbo.fn_RemoveNonPrintableChars(arp64.DisplayName0))), '') IS NOT NULL
        THEN dbo.fn_RemoveNonPrintableChars(arp64.DisplayName0)
        WHEN NULLIF(LTRIM(RTRIM(arp64.ProdID0)), '') IS NOT NULL
        THEN arp64.ProdID0 + ' (kein Anzeigename)'
        ELSE '(kein Anzeigename)'
    END                                                       AS DisplayName0,
    Publisher0,
    Version0,
    sys.Name0                                                 AS ComputerName,
    @CollID                                                   AS CollectionID
FROM v_GS_ADD_REMOVE_PROGRAMS_64 arp64
JOIN v_FullCollectionMembership fcm ON arp64.ResourceID = fcm.ResourceID
JOIN v_R_System sys ON sys.ResourceID = arp64.ResourceID
WHERE fcm.CollectionID = @CollID
ORDER BY Publisher0, DisplayName0, Version0, ComputerName
        </CommandText>
      </Query>
      <Fields>
        <Field Name="DisplayName0"><DataField>DisplayName0</DataField></Field>
        <Field Name="Publisher0"><DataField>Publisher0</DataField></Field>
        <Field Name="Version0"><DataField>Version0</DataField></Field>
        <Field Name="ComputerName"><DataField>ComputerName</DataField></Field>
        <Field Name="CollectionID"><DataField>CollectionID</DataField></Field>
      </Fields>
    </DataSet>

  </DataSets>

  <ReportParameters>
    <ReportParameter Name="UserTokenSIDs">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>=SrsResources.UserIdentity.GetUserSIDs(User!UserID)</Value></Values></DefaultValue>
      <Hidden>true</Hidden>
    </ReportParameter>    <ReportParameter Name="UserSIDs">
      <DataType>String</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DataSetAdminID</DataSetName>
          <ValueField>UserSIDs</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Hidden>true</Hidden>
    </ReportParameter>
    <ReportParameter Name="CollID">
      <DataType>String</DataType>
      <Prompt>Serverrolle</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>DataSet1</DataSetName>
          <ValueField>CollectionID</ValueField>
          <LabelField>Name</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>

