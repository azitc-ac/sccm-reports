                  <Style>
                    <BackgroundColor>#005a9e</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                    <Border><Style>None</Style></Border>
                    <BottomBorder><Style>Solid</Style><Color>#003f73</Color><Width>1pt</Width></BottomBorder>
                    <PaddingLeft>5pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                  </Style>
                </Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="hPublisher">
                  <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                  <UserSort><SortExpression>=Fields!Publisher.Value</SortExpression><SortExpressionScope>grpApp</SortExpressionScope></UserSort>
                  <Paragraphs><Paragraph><TextRuns><TextRun>
                    <Value>Herausgeber</Value>
                    <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style>
                  </TextRun></TextRuns><Style/></Paragraph></Paragraphs>
                  <Style>
                    <BackgroundColor>#005a9e</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                    <Border><Style>None</Style></Border>
                    <BottomBorder><Style>Solid</Style><Color>#003f73</Color><Width>1pt</Width></BottomBorder>
                    <PaddingLeft>5pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                  </Style>
                </Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="hSollVersion">
                  <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                  <UserSort><SortExpression>=Fields!SollVersion.Value</SortExpression><SortExpressionScope>grpApp</SortExpressionScope></UserSort>
                  <Paragraphs><Paragraph><TextRuns><TextRun>
