                  <Style>
                    <BackgroundColor>#005a9e</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                    <Border><Style>None</Style></Border>
                    <BottomBorder><Style>Solid</Style><Color>#003f73</Color><Width>1pt</Width></BottomBorder>
                    <PaddingLeft>5pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                  </Style>
                </Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="hClients">
                  <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                  <Paragraphs><Paragraph><TextRuns><TextRun>
                    <Value>Clients mit Installationsdatum (klicken zum Aufklappen)</Value>
