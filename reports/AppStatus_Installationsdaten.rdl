<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
  <rd:ReportServerUrl>http://CMSERVER/ReportServer</rd:ReportServerUrl>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=CMSERVER;Initial Catalog=CM_P01</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>11111111-1111-1111-1111-111111111111</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="DataSetAdminID">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@UserTokenSIDs">
            <Value>=Parameters!UserTokenSIDs.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select dbo.fn_rbac_GetAdminIDsfromUserSIDs(@UserTokenSIDs) as UserSIDs</CommandText>
      </Query>
      <Fields>
        <Field Name="UserSIDs"><rd:TypeName>System.String</rd:TypeName><DataField>UserSIDs</DataField></Field>
      </Fields>
    </DataSet>

    <DataSet Name="Installationen">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@UserSIDs">
            <Value>=Parameters!UserSIDs.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    CASE WHEN CHARINDEX(' - ', app.DisplayName) &gt; 0
                THEN LEFT(app.DisplayName, CHARINDEX(' - ', app.DisplayName) - 1)
                ELSE app.DisplayName END                                                AS AppName,
    app.Manufacturer                                          AS Publisher,
    app.SoftwareVersion                                       AS SollVersion,
    ads.MachineName                                           AS ComputerName,
    CASE
        WHEN arp.InstallDate0 IS NOT NULL AND LEN(arp.InstallDate0) = 8 AND TRY_CONVERT(date, arp.InstallDate0, 112) IS NOT NULL
        THEN CONVERT(date, arp.InstallDate0, 112)
        ELSE NULL
    END                                            AS InstallDatum,
    CASE
        WHEN arp.DisplayName0 IS NULL     THEN 'Kein ARP-Eintrag'
        WHEN arp.InstallDate0 IS NULL     THEN 'Datum nicht hinterlegt'
        ELSE NULL
    END                                                       AS DatumHinweis
FROM fn_rbac_AppDeploymentAssetDetails(1033, @UserSIDs) ads
INNER JOIN v_ApplicationAssignment aa
    ON  aa.AssignmentID   = ads.AssignmentID
    AND aa.OfferTypeID    = 0
    AND aa.CollectionName LIKE 'ins-req-dev-%'
INNER JOIN v_Applications app ON app.ModelId = aa.AppModelID
OUTER APPLY (
    -- The ARP entry of the deployed product: the shortest display name that
    -- starts with the application name, highest version first.
    SELECT TOP 1 DisplayName0, InstallDate0, Version0
    FROM (
        SELECT DisplayName0, InstallDate0, Version0, ResourceID FROM v_GS_ADD_REMOVE_PROGRAMS
        UNION ALL
        SELECT DisplayName0, InstallDate0, Version0, ResourceID FROM v_GS_ADD_REMOVE_PROGRAMS_64
    ) arp_all
    WHERE arp_all.ResourceID = ads.MachineID
      AND arp_all.DisplayName0 LIKE CASE WHEN CHARINDEX(' - ', app.DisplayName) &gt; 0
                THEN LEFT(app.DisplayName, CHARINDEX(' - ', app.DisplayName) - 1)
                ELSE app.DisplayName END + '%'
    ORDER BY LEN(arp_all.DisplayName0) ASC, arp_all.Version0 DESC
) arp
-- Installed only: an ARP entry, or the client's own installed + compliant.
-- EnforcementState 1001 alone is not proof of an installation.
WHERE arp.DisplayName0 IS NOT NULL
   OR (ads.InstalledState = 2 AND ads.ComplianceState = 1)
ORDER BY AppName, SollVersion, InstallDatum, ComputerName</CommandText>
      </Query>
      <Fields>
        <Field Name="AppName"><DataField>AppName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Publisher"><DataField>Publisher</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="SollVersion"><DataField>SollVersion</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ComputerName"><DataField>ComputerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="InstallDatum"><DataField>InstallDatum</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="DatumHinweis"><DataField>DatumHinweis</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportParameters>
    <ReportParameter Name="UserTokenSIDs">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>=SrsResources.UserIdentity.GetUserSIDs(User!UserID)</Value></Values></DefaultValue>
      <Hidden>true</Hidden>
    </ReportParameter>    <ReportParameter Name="UserSIDs">
      <DataType>String</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>DataSetAdminID</DataSetName>
          <ValueField>UserSIDs</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Hidden>true</Hidden>
    </ReportParameter>
  </ReportParameters>

  <ReportSections>
  <ReportSection>
  <Width>23cm</Width>
  <Body>
    <Height>200mm</Height>
    <Style><BackgroundColor>White</BackgroundColor></Style>
    <ReportItems>

