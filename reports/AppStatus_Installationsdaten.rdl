            <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
            <Top>0.2cm</Top><Left>0.4cm</Left><Width>18cm</Width><Height>0.8cm</Height>
            <Paragraphs><Paragraph>
              <TextRuns><TextRun>
                <Value>Anwendungs-Installationsstatus - Installationsdaten</Value>
