  Format(CDate(Fields!InstallDatum.Value), "dd.MM.yyyy"))</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize>
                        <Color>=IIF(IsNothing(Fields!InstallDatum.Value), "#AAAAAA", "#333333")</Color>
                      </Style>
                    </TextRun></TextRuns>
                    <Style><TextAlign>Center</TextAlign></Style>
                  </Paragraph></Paragraphs>
                  <Style>
                    <Border><Style>None</Style></Border>
                    <BottomBorder><Style>Solid</Style><Color>#e8e8e8</Color><Width>0.5pt</Width></BottomBorder>
                    <BackgroundColor>#F5F8FF</BackgroundColor>
