                </Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="dSollVersion">
                  <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                  <Paragraphs><Paragraph><TextRuns><TextRun>
                    <Value>=Fields!SollVersion.Value</Value>
                    <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#555555</Color></Style>
                  </TextRun></TextRuns><Style/></Paragraph></Paragraphs>
                  <Style>
                    <BackgroundColor>=IIF(RowNumber("grpApp") MOD 2 = 0, "#EEF4FB", "White")</BackgroundColor>
                    <VerticalAlign>Middle</VerticalAlign>
                    <Border><Style>None</Style></Border>
                    <BottomBorder><Style>Solid</Style><Color>#ddeaf5</Color><Width>0.5pt</Width></BottomBorder>
                    <PaddingLeft>5pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                  </Style>
                </Textbox></CellContents></TablixCell>

                <!-- Client-Preview mit Toggle -->
                <TablixCell><CellContents><Textbox Name="dClientPreview">
                  <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                  <Paragraphs><Paragraph><TextRuns><TextRun>
                    <Value>=First(Fields!ComputerName.Value, "grpApp") &amp;
  IIF(IsNothing(First(Fields!InstallDatum.Value, "grpApp")),
      IIF(IsNothing(First(Fields!DatumHinweis.Value, "grpApp")), "", " (" &amp; First(Fields!DatumHinweis.Value, "grpApp") &amp; ")"),
      " (" &amp; Format(First(Fields!InstallDatum.Value, "grpApp"), "dd.MM.yyyy") &amp; ")") &amp;
  IIF(CountDistinct(Fields!ComputerName.Value, "grpApp") &gt; 1,
      ", (+" &amp; (CountDistinct(Fields!ComputerName.Value, "grpApp") - 1).ToString() &amp; " weitere)",
      "")</Value>
                    <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#555555</Color></Style>
                  </TextRun></TextRuns><Style/></Paragraph></Paragraphs>
                  <ToolTip>=CountDistinct(Fields!ComputerName.Value, "grpApp") &amp; " Client(s) – klicken zum Aufklappen"</ToolTip>
                  <Style>
                    <BackgroundColor>=IIF(RowNumber("grpApp") MOD 2 = 0, "#EEF4FB", "White")</BackgroundColor>
                    <VerticalAlign>Middle</VerticalAlign>
                    <Border><Style>None</Style></Border>
                    <BottomBorder><Style>Solid</Style><Color>#ddeaf5</Color><Width>0.5pt</Width></BottomBorder>
                    <PaddingLeft>5pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                  </Style>
                </Textbox></CellContents></TablixCell>

              </TablixCells>
            </TablixRow>

            <!-- ROW 3: Client + Datum Detailzeile (toggle) -->
            <TablixRow>
              <Height>7mm</Height>
              <TablixCells>

                <TablixCell><CellContents><Textbox Name="dDetailBlank1">
                  <Paragraphs><Paragraph><TextRuns><TextRun><Value> </Value>
                    <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                  </TextRun></TextRuns><Style/></Paragraph></Paragraphs>
                  <Style><Border><Style>None</Style></Border><BottomBorder><Style>Solid</Style><Color>#e8e8e8</Color><Width>0.5pt</Width></BottomBorder><BackgroundColor>#F5F8FF</BackgroundColor><PaddingLeft>5pt</PaddingLeft></Style>
                </Textbox></CellContents></TablixCell>

                <TablixCell><CellContents><Textbox Name="dDetailBlank2">
                  <Paragraphs><Paragraph><TextRuns><TextRun><Value> </Value>
                    <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                  </TextRun></TextRuns><Style/></Paragraph></Paragraphs>
                  <Style><Border><Style>None</Style></Border><BottomBorder><Style>Solid</Style><Color>#e8e8e8</Color><Width>0.5pt</Width></BottomBorder><BackgroundColor>#F5F8FF</BackgroundColor></Style>
                </Textbox></CellContents></TablixCell>

                <!-- Installationsdatum -->
                <TablixCell><CellContents><Textbox Name="dInstallDatum">
                  <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                  <Paragraphs><Paragraph>
                    <TextRuns><TextRun>
