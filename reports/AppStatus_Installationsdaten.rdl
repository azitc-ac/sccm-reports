                    <PaddingLeft>4pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                  </Style>
                </Textbox></CellContents></TablixCell>

                <!-- Computername mit Link -->
                <TablixCell><CellContents><Textbox Name="dComputerName">
                  <CanGrow>false</CanGrow><KeepTogether>true</KeepTogether>
                  <Paragraphs><Paragraph>
                    <TextRuns><TextRun>
                      <Value>="    " &amp; Fields!ComputerName.Value</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize>
                        <FontWeight>Bold</FontWeight><TextDecoration>Underline</TextDecoration>
                        <Color>#0078d4</Color>
                      </Style>
                    </TextRun></TextRuns><Style/>
                  </Paragraph></Paragraphs>
                  <ActionInfo>
                    <Actions>
                      <Action>
                        <Drillthrough>
                          <ReportName>/ConfigMgr_P01/Softwareverteilung - Anwendungsüberwachung/Anwendungs-Installationsstatus - Details</ReportName>
                          <Parameters>
                            <Parameter Name="ComputerName">
                              <Value>=Fields!ComputerName.Value</Value>
                            </Parameter>
                          </Parameters>
                        </Drillthrough>
                      </Action>
                    </Actions>
                  </ActionInfo>
                  <ToolTip>=Fields!ComputerName.Value &amp; " – App-Installationsstatus öffnen"</ToolTip>
                  <Style>
                    <Border><Style>None</Style></Border>
                    <BottomBorder><Style>Solid</Style><Color>#e8e8e8</Color><Width>0.5pt</Width></BottomBorder>
                    <BackgroundColor>#EEF4FB</BackgroundColor>
                    <VerticalAlign>Middle</VerticalAlign>
                    <PaddingLeft>5pt</PaddingLeft><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                  </Style>
                </Textbox></CellContents></TablixCell>

              </TablixCells>
            </TablixRow>

          </TablixRows>
        </TablixBody>
      </Tablix>

    </ReportItems>
  </Body>

